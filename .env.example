# App
PORT=8080
APP_ENV=dev
CORS_ORIGIN=https://prosto-namekni.ru,https://santa.prosto-namekni.ru
COOKIE_DOMAIN=prosto-namekni.ru

# DB
# In docker-compose (production): DB_HOST=postgres, DB_PORT=5432
# In local dev (outside docker): DB_HOST=localhost, DB_PORT=5430
DB_HOST=localhost
DB_PORT=5430
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wishlist_db
DB_SSLMODE=disable

# Auth
JWT_SECRET=your-secret-key
BOT_TOKEN=your-telegram-bot-token

# Тайный Санта — уведомления
# Без SMTP_HOST письма пишутся в лог; без токена бота — сообщения в лог.
# Для Yandex Cloud Postbox: SMTP_HOST=postbox.cloud.yandex.net (+ SMTP_USER/SMTP_PASSWORD).
SANTA_PUBLIC_URL=https://santa.prosto-namekni.ru
API_PUBLIC_URL=https://api.prosto-namekni.ru
# Yandex Cloud Postbox: 587 — STARTTLS, 465 — TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Тайный Санта <santa@prosto-namekni.ru>
# Бот: по умолчанию тот же, что вход через Telegram (BOT_TOKEN)
SANTA_BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Production: Yandex Object Storage. Create bucket/access permissions in the cloud console.
# Endpoint has no scheme/path. Public URL includes the bucket exactly once.
S3_ENDPOINT=storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET_NAME=prosto-namekni-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://storage.yandexcloud.net/prosto-namekni-prod
S3_USE_SSL=true
S3_AUTO_CREATE_BUCKET=false

# For local MinIO instead: unset S3_* values above and use these MINIO_* settings.
# Explicitly set S3_AUTO_CREATE_BUCKET=true to provision the local bucket.
# MINIO_ENDPOINT=localhost:9000
# MINIO_PUBLIC_URL=http://localhost:9000
# MINIO_BUCKET_NAME=wish-list-bucket
# MINIO_ROOT_USER=root
# MINIO_ROOT_PASSWORD=minio_password
# MINIO_USE_SSL=false
